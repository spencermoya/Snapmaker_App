[Unit]
Description=Snapmaker Control Dashboard
After=network.target postgresql.service

[Service]
Type=simple
User=spencermoya
WorkingDirectory=/home/spencermoya/Snapmaker_App
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://snapmaker:Server1@127.0.0.1:5432/snapmaker

# Push Notification VAPID keys (required for iOS/Safari push notifications)
# Generate your own keys with: npx web-push generate-vapid-keys
Environment=VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
Environment=VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
Environment=VAPID_EMAIL=mailto:your-email@example.com

[Install]
WantedBy=multi-user.target
